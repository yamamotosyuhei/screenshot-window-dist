#!/bin/bash
# lastshot — スクショ窓口の最新スクショのパスを出力（エージェント用）
# 使い方: lastshot        → 最新1枚（パス TAB 経過時間）
#         lastshot -n 3   → 直近3枚（新しい順）
# 出力例: /Users/.../スクリーンショット 2026-07-20 16.05.54.png	30分前
DIR="$HOME/Pictures/スクショ窓口"
N=1
while getopts "n:" opt; do
  case $opt in
    n) N=$OPTARG ;;
    *) echo "usage: lastshot [-n 枚数]" >&2; exit 2 ;;
  esac
done

now=$(date +%s)
found=0
while IFS= read -r f; do
  [ -z "$f" ] && continue
  found=1
  mt=$(stat -f %m "$f")
  d=$(( now - mt ))
  if   [ "$d" -lt 60 ];    then age="${d}秒前"
  elif [ "$d" -lt 3600 ];  then age="$(( d / 60 ))分前"
  elif [ "$d" -lt 86400 ]; then age="$(( d / 3600 ))時間前"
  else                          age="$(( d / 86400 ))日前"
  fi
  printf '%s\t%s\n' "$f" "$age"
done < <(ls -t "$DIR"/*.png "$DIR"/*.jpg "$DIR"/*.jpeg 2>/dev/null | head -n "$N")

if [ "$found" -eq 0 ]; then
  echo "スクショ窓口にスクショがありません: $DIR" >&2
  exit 1
fi
